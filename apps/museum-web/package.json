{
  "name": "@drf-museum/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/prepare-web-public.mjs && vite",
    "prebuild": "node ../../scripts/prepare-web-public.mjs",
